{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Signal Desk",
  "version": "0.1.0",
  "identifier": "fr.signaldigital.signaldesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Signal Desk",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Signal Digital",
    "category": "Business",
    "shortDescription": "CRM, devis, facturation et signatures",
    "longDescription": "Signal Desk : CRM commercial, devis, factures, signatures et sauvegardes, entièrement local.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "languages": ["French"], "installMode": "currentUser" },
      "wix": { "language": "fr-FR" }
    }
  }
}
